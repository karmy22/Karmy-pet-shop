REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_ADMIN_EMAILS=your_admin_email_here@example.com

# Firebase — https://console.firebase.google.com → Project Settings → Your Apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id_here

# Unsplash Dataset API — https://github.com/unsplash/datasets
# Register a free app at https://unsplash.com/developers to get an Access Key.
# Free tier: 50 requests/hour (demo). Production apps can apply for higher limits.
REACT_APP_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
