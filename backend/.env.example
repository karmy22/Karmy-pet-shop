# MongoDB connection string — https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/karmy-pet-shop?retryWrites=true&w=majority

# Firebase Admin SDK — path to your service account JSON (never commit the file itself)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# Server port (optional, defaults to 5000)
PORT=5000
